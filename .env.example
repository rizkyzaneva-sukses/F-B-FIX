APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_ENABLED=false

# Session signing secret (MUST be different from POSTGREST_JWT_SECRET in production)
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# PostgREST internal URL (don't expose to browser)
POSTGREST_URL=http://localhost:3001
POSTGREST_SCHEMA=public
POSTGREST_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
POSTGREST_ADMIN_JWT=

# Must match PGRST_JWT_SECRET in PostgREST container
PGRST_DB_URI=postgres://dapurkasir:change-me@postgres:5432/dapurkasir
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=anon
PGRST_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Email provider: "console" (dev), "resend", or "sendgrid"
EMAIL_PROVIDER=console
EMAIL_FROM=DapurKasir <noreply@dapurkasir.com>
RESEND_API_KEY=
SENDGRID_API_KEY=

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Admin panel (comma-separated emails)
ADMIN_EMAILS=admin@dapurkasir.com
