APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_ENABLED=false

# URL internal PostgREST, jangan expose JWT admin ke browser.
POSTGREST_URL=http://localhost:3001
POSTGREST_SCHEMA=public
POSTGREST_JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
POSTGREST_ADMIN_JWT=

# Harus sama dengan PGRST_JWT_SECRET di container PostgREST.
PGRST_DB_URI=postgres://dapurkasir:change-me@postgres:5432/dapurkasir
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=anon
PGRST_JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
