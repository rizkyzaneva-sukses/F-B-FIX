APP_URL=http://localhost:3000
APP_VERSION=1.4.0
NEXT_PUBLIC_BACKEND_ENABLED=true

# Mode klon: 1 app = 1 toko. Matikan hanya kalau sengaja pakai mode SaaS lama.
SINGLE_TENANT=true
NEXT_PUBLIC_SINGLE_TENANT=true

# Bootstrap toko + owner otomatis saat businesses kosong.
OWNER_EMAIL=admin@toko.local
OWNER_PASSWORD=admin1234
OWNER_NAME=Owner
BUSINESS_NAME=Toko Kelontong

# Session signing secret (MUST be different from POSTGREST_JWT_SECRET in production)
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# PostgREST internal URL (don't expose to browser)
POSTGREST_URL=http://localhost:3001
POSTGREST_SCHEMA=public
POSTGREST_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
POSTGREST_ADMIN_JWT=

# Must match PGRST_JWT_SECRET in PostgREST container
PGRST_DB_URI=postgres://dapurkasir:dapurkasir_local@localhost:5432/dapurkasir
DATABASE_URL=postgres://dapurkasir:dapurkasir_local@localhost:5432/dapurkasir
PGHOST=localhost
PGUSER=dapurkasir
PGPASSWORD=dapurkasir_local
PGDATABASE=dapurkasir
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=anon
PGRST_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# PostgREST reads the Postgres role from this claim (app role stays in "role")
PGRST_JWT_ROLE_CLAIM_KEY=.db_role

# Email provider: "console" (dev), "resend", or "sendgrid"
EMAIL_PROVIDER=console
EMAIL_FROM=DapurKasir <noreply@dapurkasir.com>
RESEND_API_KEY=
SENDGRID_API_KEY=

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Admin panel (comma-separated emails)
ADMIN_EMAILS=admin@dapurkasir.com

# Trial tools (isi/hapus data dummy). Set ke false sebelum dipakai client asli.
TRIAL_TOOLS_ENABLED=true
NEXT_PUBLIC_TRIAL_TOOLS=true
